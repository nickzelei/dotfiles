[user]
	name = Nick Z
	email = 2420177+nickzelei@users.noreply.github.com

# No signingkey here: it is the one genuinely machine-shaped setting, and naming a
# path this file cannot guarantee breaks every commit rather than degrading. A Coder
# workspace has no ~/.ssh/id_ed25519 and supplies its own key in /etc/gitconfig, so
# leaving this unset lets each machine's system config answer it. Set it in
# config.local below on machines that have their own.
[gpg]
	format = ssh

[commit]
	gpgsign = true

[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[init]
	defaultBranch = main

# Untracked per-machine overrides, applied last so they win over everything
# above. git silently ignores a missing include path, so most machines need no
# such file. Use it for anything machine-shaped: a different signing key path, an
# alternate identity (`includeIf "gitdir:~/work/"`), or `gpgsign = false` on a
# box where the key above isn't present.
[include]
	path = ~/.config/git/config.local
