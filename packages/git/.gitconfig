[user]
	name = Nick Z
	email = 2420177+nickzelei@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[commit]
	gpgsign = true

# Push over SSH, fetch over HTTPS. Deliberately pushInsteadOf and NOT insteadOf:
# a plain insteadOf also rewrites reads, which forces an SSH key onto anonymous
# public clones, every brew tap fetch, and any tool handed an https GitHub URL
# (CI, containers, Coder devboxes). Reads work via the osxkeychain helper or an
# injected token; only pushes need the key.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[init]
	defaultBranch = main

# Untracked per-machine overrides, applied last so they win over everything
# above. git silently ignores a missing include path, so most machines need no
# such file. Use it for anything machine-shaped: a different signing key path, an
# alternate identity (`includeIf "gitdir:~/work/"`), or `gpgsign = false` on a
# box where the key above isn't present.
[include]
	path = ~/.config/git/config.local
